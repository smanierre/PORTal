{{ define "content" }}
    <div class="admin-layout">
        {{ template "dropdown" .DropdownData }}
        <div id="admin-content" class="admin-content">
            {{ template "members" .MembersData}}
        </div>
    </div>
{{ end }}


{{ define "members" }}
    <div x-data="adminMemberList" id="members-list" class="searchable-list" {{ if .OobSwap }} hx-swap-oob="true"{{ end }}>
            <div class="member-toggle">
                <button class="button {{ if eq .DisabledMembers false}}primary{{end}}"
                        hx-get="/admin/members" hx-target="#admin-content">
                    Enabled
                </button>
                <button class="button {{ if .DisabledMembers }}primary{{end}}"
                        hx-get="/admin/members/disabled" hx-target="#admin-content">
                    Disabled
                </button>
            </div>
            <div class="searchable-list-search">
                <input class="searchable-list-search-input" placeholder="Filter"/>
                <button class="button primary" type="button">Clear</button>
            </div>
            <ul class="searchable-list-items">
                {{ range .Members }}
                    <li
                            @click="selectHandler"
                            {{ if eq $.SelectedMember.ID .ID}}x-init="selected=$el"{{ end }}
                            class="searchable-list-item {{ if eq $.SelectedMember.ID .ID}}searchable-list-item--selected{{ end }}"
                        hx-target="{{$.SwapTarget}}" hx-get="/{{$.FragmentBasePath}}/{{.ID}}">
                        {{ displayName . }}
                    </li>
                {{ end }}
            </ul>
            <button @click="clearSelectedMember" type="button" class="admin-new-member button primary" hx-get="/admin/members/add" hx-target="#member-content">New Member</button>
    </div>
    <div id="member-content">
        {{ if or (ne .SelectedMember.ID "") .MemberEditorData.NewMember }}
            {{ template "member-editor" .MemberEditorData }}
        {{end}}
    </div>
{{ end }}

{{ define "member-editor" }}
        <form x-data="adminMemberEditor" class="member-editor" hx-indicator=".form-submit"
              {{if .NewMember}}hx-post="/admin/members/add" hx-target="#admin-content"
              {{ else }}hx-post="/admin/members/{{ .SelectedMember.ID }}" hx-target="#member-content"{{ end }}
        >
            <label>ID: <input name="id" class="editor-input" disabled value="{{ .SelectedMember.ID }}" /></label>
            <label>Rank:
                <select name="grade" @change="(e) => gradeOnChange(e, '{{ .SelectedMember.ID }}')">
                    {{ range $grade, $rank := .Ranks }}
                        <option {{ if eq $grade $.SelectedMember.Grade }}selected{{ end }} value="{{$grade}}">{{$rank}}</option>
                    {{ end }}
                </select>
            </label>
            <label>First Name: <input name="first_name" value="{{ .SelectedMember.FirstName }}" /></label>
            <label>Last Name: <input name="last_name" value="{{ .SelectedMember.LastName }}" /></label>
            <label>Username: <input name="username" {{ if ne .NewMember true }}disabled{{ end }} value="{{ .SelectedMember.Username }}" /></label>
            {{ template "supervisor_list" .SupervisorListData}}
            <label>Admin: <input name="admin" type="checkbox" {{ if .SelectedMember.Admin }} checked {{ end }}></label>
            <label>Password: <input onkeyup="this.setCustomValidity('')" hx-on:htmx:validation:validate="validatePassword(this)" name="password" type="password"/></label>
            <label>Confirm Password: <input onkeyup="this.setCustomValidity('')" hx-on:htmx:validation:validate="validateConfirmPassword(this)" name="confirm_password" type="password">
            </label>
            <div style="display: flex; gap: 1rem;">
                {{ if .NewMember }} {{ template "submit-button-primary" "Create Member"}}
                {{ else }} {{ template "submit-button-primary" "Update Member" }} {{ end }}
                {{ if not .NewMember }}
                <button class="button danger form-submit" type="button" hx-post="/admin/members/{{ .SelectedMember.ID }}/{{if .SelectedMember.Disabled}}enable{{else}}disable{{end}}">
                    <span class="form-submit--text">{{ if .SelectedMember.Disabled }}Enable{{ else}}Disable{{end}} Member</span>
                    <span class="form-submit--spinner"><svg class="spinner" width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><style>.spinner_P7sC{transform-origin:center;animation:spinner_svv2 .75s infinite linear}@keyframes spinner_svv2{100%{transform:rotate(360deg)}}</style><path d="M10.14,1.16a11,11,0,0,0-9,8.92A1.59,1.59,0,0,0,2.46,12,1.52,1.52,0,0,0,4.11,10.7a8,8,0,0,1,6.66-6.61A1.42,1.42,0,0,0,12,2.69h0A1.57,1.57,0,0,0,10.14,1.16Z" class="spinner_P7sC"/></svg></span>
                </button>
                {{ end }}
            </div>
        </form>
            <script>
                document.querySelector(".member-editor").addEventListener("change", function() {
                    document.querySelector(".form-submit").disabled = false
                })
                function validatePassword(t) {
                    if (t.value.length !== 0 && t.value.length < 8) {
                        t.setCustomValidity("Password must be at least 8 characters long")
                        t.classList.add("invalid")
                    }
                }

                function validateConfirmPassword(t) {
                    const password = htmx.find("input[name=password]")
                    if (t.value !== password.value) {
                        t.setCustomValidity("Passwords do not match")
                        t.classList.add("invalid")
                    }
                    htmx.find(".member-editor").reportValidity()
                }
            </script>
{{ end }}

{{ define "supervisor_list" }}
    {{ if .PotentialSupervisors }}
    <label id="supervisor">Supervisor:
        <select name="supervisor">
            <option value="">No Supervisor</option>
            {{- range .PotentialSupervisors }}
                <option value="{{.ID}}" {{ if eq $.SelectedMember.SupervisorID .ID}}selected{{ end }}>{{ displayName . }}</option>
            {{- end }}
        </select>
    </label>
    {{ else }}
        <label style="display: none" id="supervisor"></label>
    {{ end }}
{{ end }}