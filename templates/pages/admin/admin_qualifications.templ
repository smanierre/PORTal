package admin

import (
	"PORTal/templates/components/webcomponents"
	"PORTal/types"
	"PORTal/templates"
)

type QualificationPaneData struct {
	Qualifications          []types.Qualification
	SelectedQualification   types.Qualification
	QualificationEditorData webcomponents.QualificationEditorData
	OobSwap                 bool
}

templ QualificationPane(qualifications []types.Qualification, selectedQualification types.Qualification, newQualification, oobSwap bool) {
	<div
		id="qualifications-list"
		class="searchable-list"
		if oobSwap {
			hx-swap-oob="true"
		}
	>
	    @webcomponents.SearchableList(templates.QualificationsToListItems(qualifications), selectedQualification, "#qualification-content", "/admin/qualifications", "Qualification")
	</div>
	<div id="qualification-content">
		if selectedQualification.ID != "" || newQualification {
			// @webcomponents.QualificationEditor()
		}
	</div>
}
