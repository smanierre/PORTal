package admin

import (
	"PORTal/templates/components"
	"PORTal/templates/components/webcomponents"
	"PORTal/types"
	"fmt"
	"slices"
	"PORTal/templates/helpers"
)

type QualificationPaneData struct {
	Qualifications          []types.Qualification
	SelectedQualification   types.Qualification
	QualificationEditorData QualificationEditorData
	OobSwap                 bool
}

type QualificationEditorData struct {
	SelectedQualification          types.Qualification
	PotentialInitialRequirements   []types.Requirement
	PotentialRecurringRequirements []types.Requirement
	NewQualification               bool
}

templ QualificationPane(data QualificationPaneData) {
	<div
		x-data="adminQualificationList"
		id="qualifications-list"
		class="searchable-list"
		if data.OobSwap {
			hx-swap-oob="true"
		}
	>
		<div class="searchable-list-search">
			<input class="searchable-list-search-input" placeholder="Filter"/>
			<button class="button primary" type="button">Clear</button>
		</div>
		<ul class="searchable-list-items">
			for _, qualification := range data.Qualifications {
				<li
					@click="selectHandler"
					if data.SelectedQualification.ID == qualification.ID {
						x-init="selectHandler({target: $el})"
					}
					class={ "searchable-list-item", templ.KV(data.SelectedQualification.ID == qualification.ID, "searchable-list-item--selected") }
					hx-target="#qualification-content"
					hx-get={ fmt.Sprintf("/admin/qualifications/%s", qualification.ID) }
				>
					{ qualification.Name }
				</li>
			}
		</ul>
		<button @click="clearSelectedQualification" type="button" class="admin-new-member button primary" hx-get="/admin/qualifications/add" hx-target="#qualification-content">New Qualification</button>
	</div>
	<div id="qualification-content">
		if data.SelectedQualification.ID != "" || data.QualificationEditorData.NewQualification {
			@QualificationEditor(data.QualificationEditorData)
		}
	</div>
}

templ QualificationEditor(data QualificationEditorData) {
	<form
		x-data="adminQualificationEditor"
		class="editor"
		hx-indicator=".form-submit"
		if data.NewQualification {
			hx-post="/admin/qualifications/add"
		} else {
			hx-post={ fmt.Sprintf("/admin/qualifications/%s", data.SelectedQualification.ID) }
		}
	>
		<label>ID: <input name="id" class="editor-input" disabled value={ data.SelectedQualification.ID }/></label>
		<label>Name: <input name="name" value={ data.SelectedQualification.Name }/></label>
		<label>Notes: <textarea name="notes">{ data.SelectedQualification.Notes }</textarea></label>
		<label>
			Expires: <input
			@click="handleExpiresClick"
	        name="expires"
	        type="checkbox"
	        if data.SelectedQualification.Expires {
		        checked
	        }
        />
		</label>
		<label x-ref="expires"
		if !data.SelectedQualification.Expires {
		    hidden
		}
		>Expiration Interval: <input type="number" name="expiration_interval" value={ helpers.DaysFromDuration(data.SelectedQualification.ExpirationInterval)}/>
		</label>
		<label>
			Initial Requirements:
            @webcomponents.RequirementSelector("initial_requirements", data.SelectedQualification.InitialRequirements)
            //{
                //for _, req := range data.SelectedQualification.InitialRequirements {
                //    @components.RequirementItem(req.Name, req.ID)
                //}
                //<button data-id="9cb2617a-045d-4b1f-9bf4-b024f8caf24c" type="button" class="requirement-item">
                //    First
                //    @icons.X("remove-requirement-button")
                //</button>
                //<button data-id="second_id" type="button" class="requirement-item">
                //    Second
                //    @icons.X("remove-requirement-button")
                // </button>
			//}
		</label>
		<label>
			Recurring Requirements:
			@webcomponents.MultiSelect("recurring_requirements") {
				for _, req := range data.PotentialRecurringRequirements {
					<option
						if slices.Contains(data.SelectedQualification.RecurringRequirements, req) {
							selected
						}
						value={ req.ID }
					>{ req.Name }</option>
				}
			}
		</label>
		<div style="display: flex; gap: 1rem;">
			if data.NewQualification {
				@components.SubmitButton("Create Qualification", true)
			} else {
				@components.SubmitButton("Update Qualification", true)
			}
			if !data.NewQualification {
			}
		</div>
	</form>
	<script type="text/javascript">
                document.querySelector(".editor").addEventListener("change", function() {
                    document.querySelector(".form-submit").disabled = false
                })
            </script>
}
