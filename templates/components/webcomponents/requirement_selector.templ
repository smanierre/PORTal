package webcomponents

import (
"PORTal/types"
"PORTal/templates/helpers"
)

templ RequirementSelector(inputName string, requirements []types.Requirement) {
    <requirement-selector
        requirements={helpers.RequirementsToDisplayItems(requirements)}
    >
        <select hidden multiple name={inputName}></select>
        <dialog class="requirement-dialog"></dialog>
        <div class="requirement-items">
                    <span>
                    </span>
                    <button id="add-button" type="button">Add</button>
        </div>
    </requirement-selector>
}