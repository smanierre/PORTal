package components

templ Toast(message string, danger bool) {
<div x-data="" @click="$refs.toast.classList.add('toast--hidden')"
     x-ref="toast" id="toast" hx-swap-oob="true" class={"toast", templ.KV("toast-danger", danger)}
    x-init="setTimeout(() => {
        $el.classList.add('toast--hidden');
    }, 5000)"
>
    { message }
</div>
}
